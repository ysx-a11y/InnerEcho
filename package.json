{
  "name": "innerecho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build:user && npm run build:admin",
    "build:user": "vite build",
    "build:admin": "vite build --config vite.config.admin.ts",
    "build:server": "node scripts/clean-server-build.js && node scripts/copy-dist.js && tsc -p server/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p server/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=default",
    "test:coverage": "vitest run --coverage",
    "eval:llm": "tsx scripts/llm-eval.ts",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "export-dossiers": "tsx scripts/export-data.ts",
    "recompute:credibility": "tsx server/cli/recomputeCredibility.ts",
    "gen:banks": "tsx scripts/gen-bank-modules.ts",
    "validate:banks": "tsx scripts/validate-banks.ts",
    "seo:indexnow": "tsx scripts/push-indexnow.ts",
    "prebuild": "npm run gen:banks",
    "pretest": "npm run gen:banks && npm run validate:banks",
    "predev": "npm run gen:banks",
    "pretypecheck": "npm run gen:banks"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "ip2region.js": "^3.1.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "happy-dom": "^21.0.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "tar": "^7.5.22",
    "undici": "^6.28.0"
  }
}
