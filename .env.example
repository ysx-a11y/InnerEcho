# InnerEcho server config

# === REQUIRED (server will refuse to start if missing) ===
# JWT signing secret — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string_at_least_32_chars
# Token required to access /api/admin/* endpoints (stats, error-logs)
ADMIN_TOKEN=replace_with_another_long_random_string

# === LLM ===
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Comma-separated list of allowed LLM provider hostnames (anti-SSRF whitelist)
LLM_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,api.siliconflow.cn,dashscope.aliyuncs.com

# === Server ===
PORT=3000
# user=用户端 / admin=管理端 / all=开发测试组合应用（生产禁止 all）
APP_MODE=all
NODE_ENV=development
# Optional SQLite path. Defaults to server/data/database.sqlite.
DATABASE_FILE=server/data/database.sqlite
# Comma-separated allowed CORS origins (must match your dev/prod front-end URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# JWT expiry (e.g. 7d, 30d)
JWT_EXPIRES_IN=7d
# === Field Encryption (optional) ===
# 32-byte key for encrypting sensitive dossier fields at rest (base64 or hex).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 生产环境必填（缺少时服务拒绝启动）；留空仅限开发/测试（敏感字段明文落库）。
FIELD_ENC_KEY=

# === Error Monitoring (optional) ===
# Sentry DSN — leave empty to skip error reporting
# Get one at https://sentry.io/ (free tier: 5K events/month)
# Backend (server-side):
SENTRY_DSN=
# Frontend (client-side, must be prefixed with VITE_ to be exposed to browser):
VITE_SENTRY_DSN=
